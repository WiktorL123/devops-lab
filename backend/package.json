    "@types/node": "24.13.3",
    "@types/supertest": "6.0.2",
    "eslint": "10.9.1",
    "globals": "15.14.0",
    "prisma": "6.12.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
